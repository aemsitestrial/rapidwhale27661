{
  "definitions": [
    {
      "title": "XE Feature Cards",
      "id": "xe-feature-cards",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "XE Feature Cards",
              "model": "xe-feature-cards",
              "filter": "xe-feature-cards"
            }
          }
        }
      }
    },
    {
      "title": "XE Feature Card",
      "id": "xe-feature-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "XE Feature Card",
              "model": "xe-feature-card",
              "body": "<p>Earn rebates on everyday energy-efficiency purchases and projects for your home.</p>",
              "ctaLabel": "Learn More",
              "ctaLink": "/",
              "ctaType": "cta-internal",
              "icon": "icon-faFileInvoiceDollar",
              "title": "Home Rebates",
              "variant": "variant-surface"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "xe-feature-cards",
      "fields": [
        {
          "component": "text",
          "name": "heading",
          "label": "Band Heading (optional)",
          "description": "Shown above the cards as the section's h2.",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "subheading",
          "label": "Band Body Copy (optional)",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "xe-feature-card",
      "fields": [
        {
          "component": "richtext",
          "name": "body",
          "label": "Body Copy",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "ctaLabel",
          "label": "Link Label",
          "valueType": "string",
          "value": "Learn More"
        },
        {
          "component": "aem-content",
          "name": "ctaLink",
          "label": "Link",
          "description": "The whole card links here.",
          "valueType": "string",
          "required": true
        },
        {
          "component": "select",
          "name": "ctaType",
          "label": "Link Type",
          "valueType": "string",
          "value": "cta-internal",
          "options": [
            { "name": "Internal (arrow right)", "value": "cta-internal" },
            { "name": "External — opens a new tab (arrow up-right)", "value": "cta-external" },
            { "name": "Download (arrow down)", "value": "cta-download" }
          ]
        },
        {
          "component": "reference",
          "name": "decorative",
          "label": "Illustration or Photo",
          "description": "Decorative image at the bottom of the card (not read by screen readers).",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "select",
          "name": "icon",
          "label": "Category Icon",
          "valueType": "string",
          "value": "icon-none",
          "options": [
            { "name": "None", "value": "icon-none" },
            { "name": "Bill / Invoice", "value": "icon-faFileInvoiceDollar" },
            { "name": "Solar Panel", "value": "icon-faSolarPanel" },
            { "name": "Wrench", "value": "icon-faWrench" },
            { "name": "Leaf", "value": "icon-faLeaf" },
            { "name": "Lightning Bolt", "value": "icon-faBolt" },
            { "name": "Light Bulb", "value": "icon-faLightbulb" },
            { "name": "Piggy Bank", "value": "icon-faPiggyBank" },
            { "name": "Flame", "value": "icon-faFire" }
          ]
        },
        {
          "component": "text",
          "name": "title",
          "label": "Title",
          "valueType": "string",
          "required": true
        },
        {
          "component": "select",
          "name": "variant",
          "label": "Card Color",
          "valueType": "string",
          "value": "variant-surface",
          "options": [
            { "name": "Surface (light)", "value": "variant-surface" },
            { "name": "Primary variant (dark)", "value": "variant-primary-variant" }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "xe-feature-cards",
      "components": ["xe-feature-card"]
    }
  ]
}
