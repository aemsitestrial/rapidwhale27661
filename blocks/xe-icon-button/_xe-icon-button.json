{
  "definitions": [
    {
      "title": "XE Icon Button",
      "id": "xe-icon-button",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "XE Icon Button",
              "model": "xe-icon-button",
              "link_cta": "",
              "link_label": "Add",
              "classes_icon": "faPlus",
              "classes_size": "md",
              "classes_treatment": "default",
              "classes_disabled": false
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "xe-icon-button",
      "fields": [
        {
          "component": "aem-content",
          "name": "link_cta",
          "label": "Link (optional)",
          "description": "Page path or URL. Leave empty for a plain button.",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "link_label",
          "label": "Accessible Label",
          "description": "Required. Describes the action to screen readers (aria-label).",
          "valueType": "string",
          "required": true
        },
        {
          "component": "select",
          "name": "classes_icon",
          "label": "Icon",
          "valueType": "string",
          "value": "faPlus",
          "required": true,
          "options": [
            { "name": "Arrow Right", "value": "faArrowRight" },
            { "name": "Chevron Down", "value": "faChevronDown" },
            { "name": "Chevron Right", "value": "faChevronRight" },
            { "name": "Download", "value": "faDownload" },
            { "name": "External Link", "value": "faExternalLink" },
            { "name": "Flame", "value": "faFire" },
            { "name": "Heart", "value": "faHeart" },
            { "name": "Light Bulb", "value": "faLightbulb" },
            { "name": "Lightning Bolt", "value": "faBolt" },
            { "name": "Person", "value": "faUser" },
            { "name": "Plus", "value": "faPlus" },
            { "name": "Rocket", "value": "faRocket" },
            { "name": "Star", "value": "faStar" }
          ]
        },
        {
          "component": "select",
          "name": "classes_size",
          "label": "Size",
          "valueType": "string",
          "value": "md",
          "options": [
            { "name": "Extra Extra Small", "value": "xxs" },
            { "name": "Extra Small", "value": "xs" },
            { "name": "Small", "value": "sm" },
            { "name": "Medium (default)", "value": "md" },
            { "name": "Large", "value": "lg" },
            { "name": "Extra Large", "value": "xl" },
            { "name": "2x Large", "value": "2xl" }
          ]
        },
        {
          "component": "select",
          "name": "classes_treatment",
          "label": "Treatment",
          "valueType": "string",
          "value": "default",
          "options": [
            { "name": "Default", "value": "default" },
            { "name": "Filled", "value": "filled" },
            { "name": "Outlined", "value": "outlined" }
          ]
        },
        {
          "component": "toggle",
          "name": "classes_disabled",
          "label": "Disabled",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "select",
          "name": "classes_target",
          "label": "Open In",
          "valueType": "string",
          "value": "",
          "options": [
            { "name": "Same tab (default)", "value": "" },
            { "name": "New tab (_blank)", "value": "_blank" },
            { "name": "Same tab (_self)", "value": "_self" },
            { "name": "Parent frame (_parent)", "value": "_parent" },
            { "name": "Top frame (_top)", "value": "_top" }
          ]
        }
      ]
    }
  ],
  "filters": []
}
