{
  "definitions": [
    {
      "title": "XE Icon Button",
      "id": "xe-icon-button",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "XE Icon Button",
              "model": "xe-icon-button",
              "ariaLabel": "Settings",
              "icon": "faGear",
              "size": "md",
              "treatment": "default",
              "target": "_self"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "xe-icon-button",
      "fields": [
        {
          "component": "text",
          "name": "ariaLabel",
          "label": "Accessible Label (aria-label)",
          "description": "Required. What the button does, read by screen readers, e.g. \"Xcel Energy on Facebook\". For new-tab links \"(opens in a new window)\" is added if missing.",
          "valueType": "string",
          "required": true
        },
        {
          "component": "select",
          "name": "icon",
          "label": "Icon",
          "valueType": "string",
          "value": "faGear",
          "required": true,
          "options": [
            { "name": "Arrow Down", "value": "faArrowDown" },
            { "name": "Arrow Right", "value": "faArrowRight" },
            { "name": "Arrow Up-Right From Square", "value": "faArrowUpRightFromSquare" },
            { "name": "Bill / Invoice", "value": "faFileInvoiceDollar" },
            { "name": "Chevron Down", "value": "faChevronDown" },
            { "name": "Chevron Right", "value": "faChevronRight" },
            { "name": "Close (X Mark)", "value": "faXmark" },
            { "name": "Download", "value": "faDownload" },
            { "name": "External Link", "value": "faExternalLink" },
            { "name": "Facebook", "value": "faSquareFacebook" },
            { "name": "Flame", "value": "faFire" },
            { "name": "Gear (Settings)", "value": "faGear" },
            { "name": "Heart", "value": "faHeart" },
            { "name": "Instagram", "value": "faInstagram" },
            { "name": "Leaf", "value": "faLeaf" },
            { "name": "Light Bulb", "value": "faLightbulb" },
            { "name": "Lightning Bolt", "value": "faBolt" },
            { "name": "LinkedIn", "value": "faSquareLinkedin" },
            { "name": "Menu (Bars)", "value": "faBars" },
            { "name": "Pen (Edit)", "value": "faPen" },
            { "name": "Person", "value": "faUser" },
            { "name": "Piggy Bank", "value": "faPiggyBank" },
            { "name": "Plus", "value": "faPlus" },
            { "name": "Rocket", "value": "faRocket" },
            { "name": "Search (Magnifying Glass)", "value": "faMagnifyingGlass" },
            { "name": "Solar Panel", "value": "faSolarPanel" },
            { "name": "Star", "value": "faStar" },
            { "name": "Wrench", "value": "faWrench" },
            { "name": "X (Twitter)", "value": "faXTwitter" },
            { "name": "X (Twitter), square", "value": "faSquareXTwitter" },
            { "name": "YouTube", "value": "faYoutube" }
          ]
        },
        {
          "component": "select",
          "name": "size",
          "label": "Icon Size",
          "description": "The touch target is always 48×48px.",
          "valueType": "string",
          "value": "md",
          "options": [
            { "name": "Extra Extra Small", "value": "xxs" },
            { "name": "Extra Small", "value": "xs" },
            { "name": "Small", "value": "sm" },
            { "name": "Medium (default)", "value": "md" },
            { "name": "Large", "value": "lg" },
            { "name": "Extra Large", "value": "xl" },
            { "name": "2× Extra Large", "value": "2xl" }
          ]
        },
        {
          "component": "select",
          "name": "treatment",
          "label": "Treatment",
          "valueType": "string",
          "value": "default",
          "options": [
            { "name": "Default (icon only)", "value": "default" },
            { "name": "Filled", "value": "filled" },
            { "name": "Outlined", "value": "outlined" }
          ]
        },
        {
          "component": "text",
          "name": "href",
          "label": "Link (optional)",
          "description": "Page path or URL, e.g. /profile or https://facebook.com/xcelenergy. Leave empty for a button.",
          "valueType": "string"
        },
        {
          "component": "select",
          "name": "target",
          "label": "Open In",
          "valueType": "string",
          "value": "_self",
          "condition": { "!!": [{ "var": "href" }] },
          "options": [
            { "name": "Same tab", "value": "_self" },
            { "name": "New tab", "value": "_blank" }
          ]
        }
      ]
    }
  ],
  "filters": []
}
